#include <ESP32Servo.h>

// --- Definiciones de pines y objetos ---
int swtServo = 17;
int swtBloqueo = 34;
Servo servoMotor;
int pinServo = 16;
int ledPOWER = 19;

// --- Variables Globales ---
float einicial;
float estServo;
float estBloqueo;
bool esPrimera = true;

void setup() {
  Serial.begin(115200);
  
  pinMode(ledPOWER, OUTPUT);
  digitalWrite(ledPOWER, HIGH);
  pinMode(swtServo, INPUT);
  pinMode(swtBloqueo, INPUT);
  
  servoMotor.attach(pinServo);
  servoMotor.write(0);
  einicial = digitalRead(swtServo);
}

void loop() {
  estBloqueo = digitalRead(swtBloqueo);
  estServo = digitalRead(swtServo);
  
  if(!estBloqueo){
    if (esPrimera == true && estServo != einicial) {  
      esPrimera = false;
      }
    if (esPrimera == false) {
       if (estServo != 0) {
         servoMotor.write(38);
     } else {
         servoMotor.write(76);
     }
    }
      
    }else{
      servoMotor.write(38+19);
      einicial = estServo;
      esPrimera = true;
    }
  
  
  
  delay(500);
}



float fuerza_s1;
float fuerza_s2;
float torque;
float fuerza_ef;

void setup()
{
  Serial.begin(9600);
  pinMode(A0, INPUT);
  pinMode(A3, INPUT);
}

void loop()
{
  fuerza_s1 = (10/466.0)*analogRead(A0);
  fuerza_s2 = (10/466.0)*analogRead(A3);
  
  torque = 0.075*fuerza_s1 + 0.025*fuerza_s2;
  fuerza_ef = torque/0.05;
  
  Serial.println("FUERZA 1,2 Y EFECTIVA");
  Serial.println(fuerza_s1);
  Serial.println(fuerza_s2);
  Serial.println(fuerza_ef);
 }
